            android:configChanges="fontScale|density|smallestScreenSize|screenSize|uiMode|screenLayout|orientation|navigation|keyboardHidden|keyboard|touchscreen|locale|mnc|mcc"
            android:exported="false"
            tools:ignore="DiscouragedApi" />

        <!-- Quick Launch -->
        <activity
            android:name=".ui.activities.QuickLaunchActivity"
            android:theme="@style/Base.Theme.FullScreen"
            android:screenOrientation="sensorLandscape"
            android:configChanges="fontScale|density|smallestScreenSize|screenSize|uiMode|screenLayout|orientation|navigation|keyboardHidden|keyboard|touchscreen|locale|mnc|mcc"
            android:exported="false"
            android:label="@string/quick_launch_title"
            tools:ignore="DiscouragedApi" />

        <!-- 
            INTENT HANDLER: O Coração do Bypass
            Captura URIs minecraft://, arquivos locais (.mcworld, .zip) e links web.
            Deve ser exported=true para receber intents de outros apps.
        -->
        <activity
            android:name=".ui.activities.IntentHandler"
            android:alwaysRetainTaskState="true"
            android:configChanges="fontScale|density|smallestScreenSize|screenSize|uiMode|screenLayout|orientation|navigation|keyboardHidden|keyboard|touchscreen|locale|mnc|mcc"
            android:excludeFromRecents="false"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            tools:ignore="DiscouragedApi">
            
            <meta-data
                android:name="android.app.lib_name"
                android:value="preloader" />

            <!-- 1. Captura URIs minecraft:// (Deep Links) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="minecraft" />
            </intent-filter>

            <!-- 2. Captura Arquivos Locais (.mcworld, .mcpack, .zip, etc) -->
            <!-- Estes filtros garantem que o launcher apareça no menu "Abrir com" -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <!-- Mimetypes genéricos para arquivos -->
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="*/*" />

                <!-- Esquemas file:// e content:// -->
                <data android:scheme="file" />
                <data android:scheme="content" />
                
                <!-- Sufixos específicos do Minecraft -->
                <data android:pathSuffix=".mcworld" />
                <data android:pathSuffix=".mcpack" />
                <data android:pathSuffix=".mcaddon" />
                <data android:pathSuffix=".mctemplate" />
                <data android:pathSuffix=".zip" />
                <data android:pathSuffix=".levibackup" />
                <data android:pathSuffix=".levipack" />
                <data android:pathSuffix=".mcmod" />
                <data android:pathSuffix=".so" />
            </intent-filter>

            <!-- 3. Captura Convites Xbox Live -->
            <intent-filter>
                <action android:name="xbox_live_game_invite" />
                <action android:name="xbox_live_achievement_unlock" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Atividades de Carregamento e Jogo (Embutido) -->
        <activity
            android:name=".core.minecraft.MinecraftLoadingActivity"
            android:alwaysRetainTaskState="true"
            android:configChanges="fontScale|density|smallestScreenSize|screenSize|uiMode|screenLayout|orientation|navigation|keyboardHidden|keyboard|touchscreen|locale|mnc|mcc"
            android:excludeFromRecents="false"
            android:exported="false"
            android:launchMode="standard"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/MinecraftLoadingTheme"
            tools:ignore="DiscouragedApi" />

        <activity
            android:name=".core.minecraft.MinecraftActivity"
            android:alwaysRetainTaskState="true"
            android:configChanges="fontScale|density|smallestScreenSize|screenSize|uiMode|screenLayout|orientation|navigation|keyboardHidden|keyboard|touchscreen|locale|mnc|mcc"
            android:excludeFromRecents="false"
            android:exported="false"
            android:launchMode="standard"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/AppFullScreenTheme"
            tools:ignore="DiscouragedApi">
            <meta-data
                android:name="android.app.lib_name"
