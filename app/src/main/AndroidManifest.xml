            android:configChanges="fontScale|density|smallestScreenSize|screenSize|uiMode|screenLayout|orientation|navigation|keyboardHidden|keyboard|touchscreen|locale|mnc|mcc"
            android:excludeFromRecents="true"
            android:exported="false"
            android:finishOnTaskLaunch="true"
            android:launchMode="singleTask"
            android:process=":crash"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/LauncherRestartTheme"
            tools:ignore="DiscouragedApi" />

        <!-- Integração com Microsoft (Auth/Login) -->
        <activity
            android:name="com.microsoft.xal.browser.IntentHandler"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="keyboardHidden|orientation|screenSize|uiMode"
            android:alwaysRetainTaskState="true"
            tools:replace="android:configChanges,android:exported">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <data
                    android:scheme="ms-xal-0000000048183522"
                    android:host="auth" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.microsoft.xal.browser.BrowserLaunchActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:configChanges="keyboardHidden|orientation|screenSize|uiMode"
            android:alwaysRetainTaskState="true"
            tools:replace="android:configChanges,android:exported" />

        <activity
            android:name="com.microsoft.xal.browser.WebKitWebViewController"
            android:exported="false"
            android:launchMode="singleTask"
            android:configChanges="keyboardHidden|orientation|screenSize|uiMode"
            android:alwaysRetainTaskState="true"
            tools:replace="android:configChanges,android:exported" />

        <!-- Crash Handler -->
        <activity
            android:name="org.levimc.launcher.ui.activities.CrashActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:process=":crash"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Base.Theme.FullScreen"
            android:configChanges="fontScale|density|smallestScreenSize|screenSize|uiMode|screenLayout|orientation|navigation|keyboardHidden|keyboard|touchscreen|locale|mnc|mcc" />

        <!-- 
            FILE PROVIDER: Essencial para o Bypass do PairIP
            Permite compartilhar arquivos locais (mundos, mods) com o Minecraft
            oficial via URIs content:// seguros, contornando restrições de 
            AttributionSource para conteúdo protegido.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths" />
        </provider>

        <!-- Remove Provider do Firebase se não estiver sendo usado -->
        <provider
            android:name="com.google.firebase.provider.FirebaseInitProvider"
            android:authorities="${applicationId}.firebaseinitprovider"
            tools:node="remove" />
    </application>

</manifest>
